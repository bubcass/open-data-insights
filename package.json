{
  "name": "open-data-insights",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "npm@10.9.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "gh-pages -d dist",
    "security:audit": "npm audit --audit-level=critical",
    "security:runtime": "npm audit --omit=dev --audit-level=high",
    "portfolio:status": "node scripts/commit-portfolio.mjs",
    "portfolio:commit": "node scripts/commit-portfolio.mjs --commit",
    "portfolio:data-policy": "node scripts/check-framework-browser-data.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "verify": "npm run build && npm run verify:build && npm run security:runtime"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "papaparse": "5.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.0",
    "gh-pages": "6.3.0",
    "vite": "8.2.2"
  }
}
